# Explicitly ignore Keil build output folders
**/Targets/
**/Build/
**/Debug/
**/Release/

# Keil user-specific files (complete pattern)
*.uvguix.*
*.uvoptx
*.uvprojx.user
*.uvmpw.user

# Build artifacts (already partially covered, but adding for completeness)
*.hex
*.bin
*.axf
*.map
*.lst
*.crf
*.dep
*.d
*.o
*.obj
*.sct
*.lnp
*.htm
*.scr

# Temporary and backup files
*.bak
*.tmp
*.log
*.swp
*.swo

# IDE specific
.vscode/
.idea/
*.user

# DebugConfig folders (Keil debug configurations)
**/DebugConfig/

# EventRecorder stub files
**/EventRecorderStub.scvd

# Desktop.ini (Windows folder settings)
**/desktop.ini

# Keil user-specific files
*.uvguix.*
*.uvoptx
*.uvprojx.user
*.uvmpw.user
*.scvd

# Build output
**/Targets/
**/Build/
**/Debug/
**/Release/
*.hex
*.bin
*.axf
*.map
*.lst
